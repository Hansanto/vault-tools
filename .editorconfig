[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
max_line_length = 120

[{*.json,*.yaml,*.yml,*.md}]
indent_size = 2

[*.{kt,kts}]
ktlint_code_style = intellij_idea
ktlint_standard_trailing-comma-on-call-site = disabled
ktlint_standard_trailing-comma-on-declaration-site = disabled

[{playwright/{cosmic,seller-portal}/src/main/kotlin/**.kt}]
# We want to have the same file structure than website
# So that's not a problem to have a file "Logs.kt" with a class "LogsPage" inside
ktlint_standard_filename = disabled

[*.properties]
ij_properties_keep_blank_lines = true

[settings.gradle.kts]
max_line_length = off
